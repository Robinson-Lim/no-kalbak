<Application x:Class="DnfItemChecker.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DnfItemChecker.App"
             xmlns:conv="clr-namespace:DnfItemChecker.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/AnticBrown.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:OutcomeToBrushConverter x:Key="OutcomeToBrush" />
            <conv:OutcomeToTextConverter x:Key="OutcomeToText" />
            <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

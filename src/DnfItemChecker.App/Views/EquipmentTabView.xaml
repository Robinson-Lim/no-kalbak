<UserControl x:Class="DnfItemChecker.App.Views.EquipmentTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DnfItemChecker.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:EquipmentTabViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1000">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Header}" Style="{StaticResource HeaderText}" />
            <Button Grid.Column="1" Content="새로고침" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Margin="0,0,0,8" Padding="8,5"
                Background="{StaticResource BgRaisedBrush}" BorderBrush="{StaticResource MismatchBrush}" BorderThickness="1"
                Visibility="{Binding HasMissingReferences, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="⚠ 일부 장비의 100% 기준 값이 능력치 표에 없습니다. ④ 능력치 표 탭에서 값을 확인/추가하세요."
                       Foreground="{StaticResource TextBrush}" />
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="부위" Binding="{Binding SlotName}" Width="120" />
                <DataGridTextColumn Header="아이템" Binding="{Binding ItemName}" Width="2*" />
                <DataGridTextColumn Header="레어리티" Binding="{Binding Rarity}" Width="90" />
                <DataGridTextColumn Header="등급" Binding="{Binding GradeTier}" Width="80" />
                <DataGridTextColumn Header="100% 기준 주능력치" Binding="{Binding ReferenceDisplay}" Width="160" />
                <DataGridTextColumn Header="실측 주능력치" Binding="{Binding ObservedDisplay}" Width="145" />
                <DataGridTemplateColumn Header="판별" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource BadgeBorder}"
                                    Background="{Binding Outcome, Converter={StaticResource OutcomeToBrush}}"
                                    ToolTip="{Binding Note}">
                                <TextBlock Style="{StaticResource BadgeText}"
                                           Text="{Binding OutcomeDisplay}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Margin="0,8,0,0" Padding="8,5" Background="{StaticResource BgRaisedBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SubtleText}" />
        </Border>
    </Grid>
</UserControl>
